{
  "analysis": {
    "filter": {
      "french_elision": {
        "type": "elision",
        "articles_case": true,
        "articles": ["l", "m", "t", "qu", "n", "s", "j", "d", "c", "jusqu", "quoiqu", "lorsqu", "puisqu"]
      },
      "french_stemmer": {
        "type": "stemmer",
        "language": "light_french"
      }
    },
    "analyzer": {
      "ecm_french": {
        "tokenizer": "standard",
        "filter": ["french_elision", "lowercase", "asciifolding", "french_stemmer"]
      },
      "ecm_folding": {
        "tokenizer": "standard",
        "filter": ["lowercase", "asciifolding"]
      }
    }
  }
}
